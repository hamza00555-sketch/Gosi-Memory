{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "bundler", "strict": true, "noEmit": true,
    "resolveJsonModule": true, "skipLibCheck": true, "jsx": "react-jsx",
    "noUnusedLocals": true, "noUncheckedIndexedAccess": true,
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src/domain/**/*", "src/content/**/*", "src/game/**/*"]
}
