{
  "name": "gosi-memory",
  "version": "0.1.0",
  "private": true,
  "description": "قوسي / GOSI — لعبة ذاكرة ببطاقات مطبوعة وواقع معزّز من المتصفح.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
