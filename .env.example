# QAWSI / قوسي ميموري — environment variables
# Copy to .env.local and fill in from the Firebase console
# (Project settings → General → Your apps → SDK setup and configuration).
#
# Without a complete Firebase config the app still boots, but it falls back to
# the single-device LocalRoomBackend: playable for development, NOT real
# two-device play.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point auth (9099) and the Realtime Database (9000) at the local emulator
# suite instead of the cloud project: `firebase emulators:start`.
VITE_FIREBASE_EMULATOR=false

# Dev-only on-screen card scanner, for testing without printed cards.
VITE_ENABLE_AR_SIMULATOR=false
