# QAWSI environment variables
# Copy to .env and fill in. Without these the app runs fully offline (LocalAdapter).

# Supabase project URL, e.g. https://xxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (safe for the browser — RLS protects the data).
VITE_SUPABASE_ANON_KEY=

# Backend mode: "local" (offline, in-memory) or "supabase" (realtime).
# Defaults to "local" when unset or when Supabase keys are missing.
VITE_BACKEND_MODE=local
