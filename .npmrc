# mind-ar depends on `canvas`, a native module needed only by its OFFLINE image
# compiler — never by the browser runtime we ship (mindar-image.prod.js is a
# prebuilt bundle). Letting npm run install scripts makes CI try to compile
# canvas with node-gyp, which fails on any build image without libcairo headers.
#
# Nothing else in this project relies on an install script: Vite's esbuild
# resolves its platform binary through optionalDependencies, not postinstall.
#
# Compiling new AR targets is an authoring step, not a build step — see
# docs/AR-TARGETS.md.
ignore-scripts=true
